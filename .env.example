# Copy to .env (or export in your shell). Everything is optional; with nothing set Rewind
# runs local sandboxes and drives Claude through the `claude` CLI (claude-cli:sonnet vs claude-cli:haiku).

# Model configs, comma-separated. Forms: claude-cli:<haiku|sonnet|opus>, anthropic:<model>, lilac:<model>, openai:<model>
# REWIND_MODELS=anthropic:claude-sonnet-5,lilac:openai/gpt-oss-120b

# ANTHROPIC_API_KEY=sk-ant-...
# LILAC_API_KEY=...            # OpenAI-compatible; base URL defaults to https://api.getlilac.com/v1 (LILAC_BASE_URL to override)
# OPENAI_API_KEY=...           # OPENAI_BASE_URL to point at any OpenAI-compatible endpoint

# Sandbox: auto (daytona if DAYTONA_API_KEY, else docker if installed, else local) | local | docker | daytona
# REWIND_SANDBOX=auto
# DAYTONA_API_KEY=...

# REWIND_MAX_INSTANCES=5
# REWIND_STEP_CAP=15
# REWIND_MAX_COMMITS=400
